# Angel Filter — local environment template.
#
#   1. cp .env.example .env        (NEVER commit .env — it is gitignored)
#   2. Fill in the values below
#   3. poetry run uvicorn angel_filter.server:app --reload --port 8005
#
# Restart the server after editing — --reload only watches .py files.
# docs/SETUP.md explains every variable.
#
# Leave optional overrides COMMENTED OUT rather than blank: a blank line like
# `GEMINI_MODEL=` sets an empty string, which replaces the code's default.

# =============================================================================
# REQUIRED — at least one provider
# =============================================================================
# The server refuses to start with none. Ollama is free and local:
#   ollama pull llama3.2 && ollama pull nomic-embed-text

OLLAMA_MODEL=llama3.2
# OLLAMA_URL=http://localhost:11434

# Uncomment and fill in any others you have keys for.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# OPENAI_API_KEY=            # also used for embeddings when Ollama is absent
# OPENAI_MODEL=gpt-4o-mini

# WATSONX_API_KEY=           # needs both key and project ID
# WATSONX_PROJECT_ID=
# WATSONX_REGION=us-south
# WATSONX_MODEL=ibm/granite-13b-instruct-v2

# BRAVE_API_KEY=

# Google Places: real distances, and geocoding for other providers' venues.
# Needs the user's location per request. Billed per call — set a budget alert.
# GOOGLE_PLACES_API_KEY=

# =============================================================================
# OPTIONAL — cost protection (defaults shown)
# =============================================================================
# There is no login, so these are the only protection on a public deploy.
# ANGEL_USER_RATE_LIMIT=30          # searches per client (IP) per window
# ANGEL_USER_RATE_WINDOW=60         # seconds
# ANGEL_DAILY_QUERY_LIMIT=500       # all clients together, per UTC day
# ANGEL_TRUSTED_PROXY_HOPS=0        # reverse proxies in front of the app;
#                                   # 0 locally, 1 on Render (see docs/SETUP.md)

# Shared state. Unset = this process's memory (fine locally). For a deployment,
# a Postgres URL keeps the cache, conversations and limits across restarts and
# workers. Free option: Supabase's Session pooler URL (docs/SETUP.md,
# "Shared state").
# ANGEL_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres

# Distance enrichment — each lookup is a billed Places call.
# ANGEL_GEOCODE_ENABLED=true        # false turns enrichment off
# ANGEL_GEOCODE_SHORTLIST=12        # candidates per query (must exceed top_k)
# ANGEL_GEOCODE_MAX_LOOKUPS=15      # hard cap on lookups per query
