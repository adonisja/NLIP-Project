# Angel Filter — local environment template.
#
# How to use:
#   1. Copy this file:           cp .env.example .env
#   2. Fill in the real values   (NEVER commit .env — it is gitignored)
#   3. Run the server            poetry run fastapi dev angel_filter/server.py
#
# Anything left at its placeholder will either fail loudly (missing GitHub
# OAuth secrets) or fall back to a safe default (rate limits, etc.).

# =============================================================================
# REQUIRED — GitHub OAuth
# =============================================================================
# Register an OAuth App at https://github.com/settings/developers
#   Homepage URL:                http://localhost:8000
#   Authorization callback URL:  http://localhost:8000/auth/github/callback
# Then paste the Client ID + Client Secret below.

GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_OAUTH_CALLBACK_URL=http://localhost:8000/auth/github/callback

# =============================================================================
# REQUIRED — Allowlist
# =============================================================================
# Comma-separated GitHub usernames allowed to sign in. Anyone not on this
# list gets a 403 after completing the OAuth flow. Case-insensitive.
# Empty allowlist = no one can log in (fail-closed).

ANGEL_ALLOWED_USERS=your-github-username,teammate1-github,teammate2-github

# =============================================================================
# RECOMMENDED — Session signing
# =============================================================================
# Used by Starlette's SessionMiddleware to sign session cookies. If unset,
# the server boots with a random per-process value, which means every
# restart logs everyone out. Set this to keep sessions stable across
# restarts and rolling deploys.
#
# Generate one with:   python -c "import secrets; print(secrets.token_hex(32))"

ANGEL_SESSION_SECRET=replace_me_with_a_random_64_char_hex_string

# =============================================================================
# COOKIE HARDENING
# =============================================================================
# Set to "true" on any HTTPS deployment (cloud). Must be "false" for local
# HTTP development, otherwise the browser refuses to send the cookie.

ANGEL_COOKIE_SECURE=false
ANGEL_COOKIE_SAMESITE=lax

# =============================================================================
# OPTIONAL — Cost protection (defaults shown)
# =============================================================================
# Per-user sliding-window rate limit, and a global daily cap on /query.
# Tune down before a public demo if you want to be extra cautious about
# upstream API spend.

ANGEL_USER_RATE_LIMIT=30
ANGEL_USER_RATE_WINDOW=60
ANGEL_DAILY_QUERY_LIMIT=500

# =============================================================================
# OPTIONAL — Server
# =============================================================================
# Port for the FastAPI app when run via `python -m angel_filter.server`.

PORT=8000

# =============================================================================
# OPTIONAL — Upstream provider keys (only set what you actually use)
# =============================================================================
# Used by the Consensus_Filter demo and any future paid providers wired
# into angel_filter/providers/. Leave blank if you're only running the
# DuckDuckGo + Mock providers.

GEMINI_API_KEY=
GEMINI_MODEL=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=
